apiVersion: v1
kind: Secret
metadata:
  name: o3c-secrets
  namespace: o3c-agent-engine
type: Opaque
stringData:
  # IMPORTANT: Replace these with your actual secrets
  # Generate secrets with: openssl rand -base64 32
  DATABASE_URL: "postgresql://o3c_user:CHANGE_ME@postgres-service:5432/o3c_agent_engine?schema=public"
  JWT_SECRET: "CHANGE_ME_JWT_SECRET"
  JWT_REFRESH_SECRET: "CHANGE_ME_JWT_REFRESH_SECRET"
  ENCRYPTION_KEY: "CHANGE_ME_ENCRYPTION_KEY"
  POSTGRES_PASSWORD: "CHANGE_ME_POSTGRES_PASSWORD"
  REDIS_PASSWORD: "CHANGE_ME_REDIS_PASSWORD"
