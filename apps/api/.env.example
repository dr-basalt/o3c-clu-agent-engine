# =================================
# APPLICATION
# =================================
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# =================================
# DATABASE
# =================================
DATABASE_URL="postgresql://o3c_user:o3c_password@localhost:5432/o3c_agent_engine?schema=public"

# =================================
# REDIS
# =================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# =================================
# JWT
# =================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRATION=7d

# =================================
# ENCRYPTION (for provider API keys)
# =================================
ENCRYPTION_KEY=your-32-character-encryption-key-change-this-in-production

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# WORKER
# =================================
WORKER_CONCURRENCY=5
MAX_JOB_DURATION_MS=300000
WORKSPACES_PATH=/data/workspaces

# =================================
# MONITORING
# =================================
ENABLE_METRICS=true
LOG_LEVEL=info
